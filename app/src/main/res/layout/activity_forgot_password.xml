<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg"
    tools:context=".activities.ForgotPasswordActivity">

    <TextView
        android:id="@+id/Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="200dp"
        android:fontFamily="@font/aclonica"
        android:shadowColor="#F10707"
        android:text="Forgot Password"
        android:textColor="@color/text_heading"
        android:textSize="30dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/aclonica"
        android:layout_marginTop="40dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:textSize="16dp"
        android:layout_gravity="center_horizontal"
        android:text="Please enter your email to get verified"
        android:textColor="#2B2D2A" />

    <EditText
        android:id="@+id/fpwdEmail"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:drawableStart="@drawable/baseline_alternate_email_24"
        android:paddingLeft="10dp"
        android:ems="10"
        android:maxLength="70"
        android:hint=" Enter your email here!"
        android:background="@drawable/edit_text_bg"
        android:inputType="textEmailAddress"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/aclonica"
        android:layout_marginTop="10dp"
        android:textSize="14dp"
        android:layout_gravity="center_horizontal"
        android:text="You may recieve email notification from us for security and login purposes."
        android:textColor="#2B2D2A"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"/>

    <TextView
        android:id="@+id/countdownTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="10dp"/>


    <Button
        android:id="@+id/Linkbutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@color/text_heading"
        android:fontFamily="@font/aclonica"
        android:text="Get Link" />

    <Button
        android:id="@+id/backToLoginButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" Back To Login"
        android:fontFamily="@font/aclonica"
        android:backgroundTint="@color/text_heading"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
       />

</LinearLayout>